<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12" stylesheets="@../styles/main.css" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="com.urbanpulse.controller.ProfileController">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="My Profile" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TextField fx:id="nameField" promptText="Full name"/>
    <TextField fx:id="emailField" promptText="Email"/>
    <Label fx:id="roleLabel"/>

    <Button text="Save Changes" onAction="#handleSave"/>
    <Label fx:id="messageLabel"/>

    <Button text="Back to Dashboard" onAction="#handleBackToDashboard"/>
</VBox>