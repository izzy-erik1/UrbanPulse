<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.urbanpulse.controller.ProfileController"
           stylesheets="@../styles/main.css">
    <VBox alignment="CENTER" spacing="12" maxWidth="360" styleClass="card">
        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>

        <Label text="My Profile" styleClass="title-label"/>

        <TextField fx:id="nameField" promptText="Full name"/>
        <TextField fx:id="emailField" promptText="Email"/>
        <Label fx:id="roleLabel"/>

        <Button text="Save Changes" onAction="#handleSave" maxWidth="Infinity"/>
        <Label fx:id="messageLabel"/>

        <Button text="Back to Dashboard" onAction="#handleBackToDashboard" maxWidth="Infinity"/>
    </VBox>
</StackPane>