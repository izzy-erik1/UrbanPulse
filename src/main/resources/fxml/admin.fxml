<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" maxWidth="700" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.urbanpulse.controller.AdminController" stylesheets="@../styles/main.css">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Admin Dashboard" styleClass="title-label"/>

    <HBox spacing="10">
        <ComboBox fx:id="municipalityFilterComboBox" promptText="Filter by Municipality"/>
        <ComboBox fx:id="statusFilterComboBox" promptText="Filter by Status"/>
        <Button text="Apply Filters" onAction="#handleApplyFilters"/>
        <Button text="Show All" onAction="#handleShowAll"/>
    </HBox>

    <ListView fx:id="issuesListView" prefHeight="300"/>

    <HBox spacing="10">
        <ComboBox fx:id="newStatusComboBox" promptText="New status for selected issue"/>
        <Button text="Update Status" onAction="#handleUpdateStatus"/>
    </HBox>

    <Label fx:id="messageLabel"/>

    <Button text="Back to Dashboard" onAction="#handleBackToDashboard"/>
</VBox>