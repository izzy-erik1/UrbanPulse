<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12"  stylesheets="@../styles/main.css"    xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="com.urbanpulse.controller.RegisterController">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="UrbanPulse Register" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <TextField fx:id="nameField" promptText="Full name"/>
    <TextField fx:id="emailField" promptText="Email"/>
    <PasswordField fx:id="passwordField" promptText="Password (min 8 characters)"/>
    <ComboBox fx:id="roleComboBox" promptText="Role"/>

    <Button text="Register" onAction="#handleRegister"/>
    <Label fx:id="messageLabel"/>

    <Button text="Already have an account? Login" onAction="#handleGoToLogin" style="-fx-background-color: transparent;"/>
</VBox>